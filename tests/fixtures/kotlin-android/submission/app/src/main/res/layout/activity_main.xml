<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
    <EditText android:id="@+id/noteInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Write a note" />
    <Button android:id="@+id/saveButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Save note" />
    <TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/notesList" android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
